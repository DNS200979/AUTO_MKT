MARKET_ENVIRONMENT=development
MARKET_LOG_LEVEL=INFO
MARKET_METRICS_ENABLED=true
MARKET_DATA_ENCRYPTION_KEYS={}
MARKET_OPERATIONAL_RETENTION_DAYS=90
MARKET_DATABASE_URL=postgresql+psycopg://market:market@localhost:5432/market
MARKET_AUTO_CREATE_SCHEMA=true
MARKET_ENFORCE_MIGRATION_HEAD=false
MARKET_OTP_TTL_MINUTES=5
MARKET_ONBOARDING_TOKEN_TTL_SECONDS=900
MARKET_ONBOARDING_TOKEN_SECRET=replace-with-at-least-32-random-characters
MARKET_REGISTRATION_RATE_LIMIT_PER_MINUTE=5
MARKET_OTP_RATE_LIMIT_PER_MINUTE=3
MARKET_CHAT_RATE_LIMIT_PER_MINUTE=30
MARKET_WEBHOOK_SECRET=change-me-in-production
MARKET_NOTIFICATION_BATCH_SIZE=25
MARKET_NOTIFICATION_MAX_ATTEMPTS=5
MARKET_NOTIFICATION_POLL_SECONDS=2
MARKET_NOTIFICATION_RETRY_BASE_SECONDS=30
MARKET_NOTIFICATION_RETRY_MAX_SECONDS=3600
MARKET_NOTIFICATION_RETRY_JITTER_RATIO=0.20
MARKET_INTEGRATION_CIRCUIT_FAILURE_THRESHOLD=5
MARKET_INTEGRATION_CIRCUIT_RECOVERY_SECONDS=30
MARKET_NOTIFICATION_PROVIDER=console
MARKET_WHATSAPP_GRAPH_VERSION=v25.0
MARKET_WHATSAPP_TIMEOUT_SECONDS=15
MARKET_WHATSAPP_PHONE_NUMBER_ID=
MARKET_WHATSAPP_ACCESS_TOKEN=
MARKET_WHATSAPP_APP_SECRET=
MARKET_WHATSAPP_VERIFY_TOKEN=
MARKET_WHATSAPP_TEMPLATE_NAME=payment_declined_v1
MARKET_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
MARKET_SIMULATION_ENABLED=true
MARKET_AUTH_MODE=development
MARKET_DEVELOPMENT_AUTH_TOKENS={"operator-local-secret":"operator-local:OPERATOR","device-local-secret":"door-1:DEVICE","integrator-local-secret":"pos-local:INTEGRATOR"}
# Para o MVP publicado, use Supabase Auth e configure a URL do projeto.
# MARKET_AUTH_MODE=supabase
# MARKET_SUPABASE_URL=https://<project-ref>.supabase.co
# MARKET_SUPABASE_JWT_AUDIENCE=authenticated
# MARKET_SUPABASE_ROLE_CLAIM=app_metadata.market_role
MARKET_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Caminho para JSON montado por Docker/Kubernetes/Vault Agent. Quando definido,
# os campos sensiveis desse arquivo substituem seus equivalentes MARKET_*.
# MARKET_SECRETS_FILE=/run/secrets/market.json
